# Server-side secrets. Do not place real values in source code or client files.
# Use your current public IP address. Add multiple values with commas.
ACCESS_ALLOWED_IPS=203.0.113.10
ACCESS_PASSWORD=replace-with-a-long-random-password
ACCESS_SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require

# Provider keys stay on the server only.
VERIPHONE_KEY=your_veriphone_api_key
AI_STUDIO_KEY=your_gemini_api_key_here
PORT=3000
